SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# --- PyTorch / GPU (optional; Settings → "Use GPU" must stay on for non-cpu devices) ---
# Full device string when GPU mode is enabled: cuda, cuda:0, cuda:1, mps (Apple GPU), cpu
# TORCH_DEVICE=cuda:0
# Shorthand GPU index if TORCH_DEVICE is unset (NVIDIA multi-GPU)
# TORCH_CUDA_DEVICE_INDEX=0
# Restrict visible GPUs (driver / CUDA); first visible GPU becomes logical cuda:0
# CUDA_VISIBLE_DEVICES=0

# Default pipeline quality before first UI choice: fast | balanced | high
# PROCESSING_QUALITY=fast
